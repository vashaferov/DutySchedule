# Шаблон окружения. Скопируйте в .env и заполните.
#
# ВАЖНО:
#   - .env НИКОГДА не коммитится (см. .gitignore);
#   - на сервере права файла должны быть 600:  chmod 600 .env
#   - после смены секретов перезапустите сервисы:
#       docker compose up -d --force-recreate api sync

# --- PostgreSQL ---
DB_NAME=duty
DB_USER=duty
DB_PASSWORD=
# Строка подключения для api/sync (внутри docker-сети: host = postgres)
DATABASE_URL=postgresql://duty:CHANGE_ME@postgres:5432/duty

# --- Секреты приложения ---
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=

# --- Ограничение попыток входа ---
# PIN четырёхзначный, поэтому перебор ограничен: столько неудачных попыток
# допускается в окне LOGIN_WINDOW_MINUTES минут — по имени пользователя и по IP
# отдельно, после чего вход отвечает 429 (см. api/app/ratelimit.py).
LOGIN_MAX_FAILURES_PER_USER=5
LOGIN_MAX_FAILURES_PER_IP=60
LOGIN_WINDOW_MINUTES=15

# --- Google Sheets ---
SPREADSHEET_ID=
# base64 от sync/credentials.json (приватный ключ сервисного аккаунта)
GOOGLE_SHEETS_CREDENTIALS=

# --- CORS ---
# Фронтенд и API отдаются одним nginx (same-origin), поэтому по умолчанию
# достаточно домена. Несколько значений — через запятую.
CORS_ORIGINS=https://mediahlg.ru
